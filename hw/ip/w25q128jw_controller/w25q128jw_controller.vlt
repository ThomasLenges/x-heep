`verilator_config

lint_off -rule DECLFILENAME -file "*/w25q128jw_controller_reg_top.sv"
lint_off -rule WIDTH -file "*/w25q128jw_controller_reg_top.sv" -match "Operator ASSIGNW expects *"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'reg2hw'*"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "* are not used: 'reg2hw'*"
lint_off -rule PINMISSING -file "*/tb/testharness.sv" -match "Cell has missing pin: 'w25q128jw_controller_done_o'"
lint_off -rule PINMISSING -file "*/x_heep_system.sv" -match "Cell has missing pin: 'w25q128jw_controller_done_o'"
lint_off -rule IMPLICIT -file "*/peripheral_subsystem.sv" -match "Signal definition not found, creating implicitly: 'w25q128jw_controller_intr_event'"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'clk_i'"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'rst_ni'"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'reg_req_i'"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'w25q128jw_controller_master_bus_resp_i'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Signal is not driven: 'reg_rsp_o'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Signal is not driven: 'w25q128jw_controller_done_o'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Signal is not driven: 'w25q128jw_controller_interrupt_o'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Signal is not driven: 'w25q128jw_controller_master_bus_req_o'"

lint_off -rule UNUSED   -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'reg2hw'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Signal is not driven: 'hw2reg'"
lint_off -rule UNDRIVEN -file "*/w25q128jw_controller.sv" -match "Bits of signal are not driven: 'hw2*"

lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'w25q128jw_controller_master_bus_resp_i*"

lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Parameter is not used: 'SPI_FLASH_RX_FIFO_DEPTH'"
lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Parameter is not used: 'SPI_FLASH_TX_FIFO_DEPTH'"

lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'dma_done'[3:1]"

lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Bits of signal are not used: 'read_value*"

lint_off -rule UNUSED -file "*/w25q128jw_controller.sv" -match "Signal is not used: 'dma_done*"
